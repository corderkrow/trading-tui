# Trading TUI environment. Copy to `.env` and adjust.
# `.env` is gitignored — never commit real secrets.

# Exchange adapter: yahoo (default) or binance
ADAPTER_NAME=yahoo

# Default symbol for market data
DEFAULT_SYMBOL=BTC-USD

# Optional: binance API credentials (only needed for binance adapter)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# SQLite alerts database path (default: project-root alerts.db)
# ALERTS_DB_PATH=alerts.db
